// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Service {
  id    Int    @id @default(autoincrement())
  name  String @unique
  leads Lead[]

  @@map("services")
}

model Provider {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  monthlyQuota   Int              @default(10)
  leadsReceived  Int              @default(0)
  allocationIndex Int             @default(0) // for fair round-robin tracking
  leadAssignments LeadAssignment[]

  @@map("providers")
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  phone       String
  city        String
  description String
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id])
  createdAt   DateTime @default(now())
  assignments LeadAssignment[]

  @@unique([phone, serviceId]) // enforce no duplicate phone+service
  @@map("leads")
}

model LeadAssignment {
  id         String   @id @default(cuid())
  leadId     String
  providerId Int
  assignedAt DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id])
  provider   Provider @relation(fields: [providerId], references: [id])

  @@unique([leadId, providerId]) // same provider can't get same lead twice
  @@map("lead_assignments")
}

// Track allocation state per service for fair round-robin
model AllocationState {
  id        Int    @id @default(autoincrement())
  serviceId Int    @unique
  nextIndex Int    @default(0) // which position in the fair pool to assign next

  @@map("allocation_states")
}

// Webhook idempotency tracking
model WebhookEvent {
  id          String   @id // idempotency key
  type        String
  processedAt DateTime @default(now())
  payload     Json

  @@map("webhook_events")
}
